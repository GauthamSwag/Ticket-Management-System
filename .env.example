# ==============================================================================
# TicketFlow Enterprise Ticket Management System - Environment Configuration
# ==============================================================================

# Core Application Settings
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
# Use mongodb://localhost:27017/ticket_management for local MongoDB daemon
# Or use 'memory' to run an embedded mongodb-memory-server instance automatically
MONGO_URI=mongodb://localhost:27017/ticket_management

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRE=30d

# File Uploads
MAX_FILE_SIZE_MB=10

# SLA Automated Monitoring Service
SLA_MONITOR_ENABLED=true
SLA_MONITOR_INTERVAL_MINUTES=1

# Email Notification Infrastructure (Nodemailer)
# If disabled or unconfigured, system operates normally without crashing
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ticketflow.enterprise

# AI-Assisted Ticket Classification (Optional Advisor)
# If disabled, keyword/NLP heuristics provide advisory fallback
AI_CLASSIFICATION_ENABLED=false
AI_API_KEY=
